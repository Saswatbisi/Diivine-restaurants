{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@workspace/db": ["./lib/db/src/index.ts"],
      "@workspace/db/schema": ["./lib/db/src/schema/index.ts"],
      "@workspace/api-zod": ["./lib/api-zod/src/index.ts"],
      "@workspace/api-client-react": ["./lib/api-client-react/src/index.ts"],
      "@workspace/api-client-react/*": ["./lib/api-client-react/*"],
      "@workspace/api-spec": ["./lib/api-spec/src/index.ts"]
    },
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "outDir": "./dist"
  },
  "exclude": ["node_modules", "dist"]
}
